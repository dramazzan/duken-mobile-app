{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },

    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },

    "preview-small": {
      "distribution": "internal",
      "env": {
        "EXPO_ANDROID_BUILD_ARCHS": "arm64-v8a"
      },
      "android": {
        "buildType": "apk"
      }
    },

    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}